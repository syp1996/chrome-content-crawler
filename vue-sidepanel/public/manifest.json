{
  "manifest_version": 3,
  "name": "Vue Sidepanel Demo",
  "version": "1.0.0",
  "description": "A demo Chrome extension with Vue-powered sidepanels",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting",
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel-global.html"
  },
  "action": {
    "default_title": "Open Sidepanel",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sidepanel-global.html", "sidepanel-tab.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "minimum_chrome_version": "114"
}